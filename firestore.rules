rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Allow read, write on all application collections for multi-device sync
    match /customers/{docId} { allow read, write: if true; }
    match /projects/{docId} { allow read, write: if true; }
    match /projects/{projectId}/{subcollection=**} { allow read, write: if true; }
    match /portfolio/{docId} { allow read, write: if true; }
    match /warranties/{docId} { allow read, write: if true; }
    match /documents/{docId} { allow read, write: if true; }
    match /payments/{docId} { allow read, write: if true; }
    match /updates/{docId} { allow read, write: if true; }
    match /team/{docId} { allow read, write: if true; }
    match /inventory/{docId} { allow read, write: if true; }
    match /schedules/{docId} { allow read, write: if true; }
    match /customer_requirements/{docId} { allow read, write: if true; }
    match /estimates/{docId} { allow read, write: if true; }
    match /subcontractor_payments/{docId} { allow read, write: if true; }
    match /contractors/{docId} { allow read, write: if true; }
    match /contractor_payments/{docId} { allow read, write: if true; }
    match /app_config/{docId} { allow read, write: if true; }
    match /users/{docId} { allow read, write: if true; }

    // Fallback rule for any other path
    match /{document=**} {
      allow read, write: if true;
    }
  }
}

